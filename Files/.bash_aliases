# General
alias monitor-list='xrandr | grep " connected"'
alias battery='upower -i /org/freedesktop/UPower/devices/battery_BAT0 | grep capacity'
alias c='clear'
alias settings='env XDG_CURRENT_DESKTOP=GNOME gnome-control-center --verbose'

# Alias
alias aliaslist='cat ~/.bash_aliases'
alias aliasedit='vim ~/.bash_aliases'
alias aliassave='source ~/.bashrc'
